# Copy to .env.auth.local (ignored). Use a separate Google OAuth web client for local testing.
NODE_ENV=development
AUTH_MODE=google
AUTH_ORIGIN=http://127.0.0.1:4177
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUAHAD_D1_PATH=.local/d1-google-local
OUAHAD_DEV_AUTH=0
# Captures codes locally; the production Worker always disables this transport.
EMAIL_SIGNIN_MODE=capture
